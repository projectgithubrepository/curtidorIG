{
  "name": "curtidorig",
  "version": "0.3.0",
  "private": true,
  "description": "Aplicativo desktop para organizar publicações do Instagram.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron .",
    "dist:mac": "PLAYWRIGHT_BROWSERS_PATH=playwright-browsers playwright install chromium && electron-builder --mac dmg",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
